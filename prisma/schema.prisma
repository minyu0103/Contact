// 근미래 어반 판타지 웹게임 - 1차 프로토타입 데이터 모델
// SPEC.md "데이터 모델 (초안)"을 바탕으로 한다. 2차 항목도 구조만 미리 둔다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── 계정 ─────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id           String      @id @default(cuid())
  loginId      String      @unique
  passwordHash String
  role         Role        @default(USER)
  createdAt    DateTime    @default(now())
  inviteCode   InviteCode? @relation("UsedInvite")
  character    Character?
  sessions     Session[]
  createdCodes InviteCode[] @relation("CreatedInvite")
  notices      Notice[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String    @default("")
  createdById String?
  createdBy   User?     @relation("CreatedInvite", fields: [createdById], references: [id], onDelete: SetNull)
  usedById    String?   @unique
  usedBy      User?     @relation("UsedInvite", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// ───────────────────────── 캐릭터 ─────────────────────────

enum AbilityCategory {
  COMBAT      // 전투형
  SEARCH      // 탐색형
  PRODUCTION  // 생산형
  SPECIAL     // 특수형
}

enum AbilityStatus {
  PENDING   // 심사 중
  ACTIVE    // 활성
  RETURNED  // 반려 (코멘트와 함께 돌려보냄)
}

enum CheckType {
  COMBAT   // 전투
  SEARCH   // 탐색
  CRAFT    // 제작 (2차)
  GENERAL  // 일반
}

model Character {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String @unique
  imageUrl  String?

  // 능력
  category             AbilityCategory
  abilityName          String
  abilityDesc          String
  abilityStatus        AbilityStatus @default(PENDING)
  abilityComment       String        @default("")
  // 특수형은 운영자가 지정. 나머지는 카테고리로 자동 결정되므로 null.
  proficiencyCheckType CheckType?
  proficiency          Int           @default(1)
  proficiencyExp       Int           @default(0)
  effects              AbilityEffect[]
  tags                 CharacterTag[]

  // 성장
  level      Int @default(1)
  exp        Int @default(0)
  statPoints Int @default(0)

  // 수치
  hp          Int
  maxHp       Int
  mp          Int
  maxMp       Int
  erosion     Int @default(0)
  ap          Int
  points      Int
  escapeCount Int @default(0)

  // 하루 횟수 (04:00 KST 초기화)
  autoSuccessUsedToday Int    @default(0)
  teleportUsedToday    Int    @default(0)
  lastDailyResetKey    String @default("") // "YYYY-MM-DD" (KST 기준 게임일)
  // 오늘 침식률 감소로 인정된 RP 댓글 수 (2차)
  rpCountToday         Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory     InventoryItem[]
  runs          Run[]
  revealedNodes Node[]          @relation("RevealedBy")

  // 커뮤니티 (2차)
  posts        Post[]          @relation("PostAuthor")
  comments     Comment[]       @relation("CommentAuthor")
  reactions    Reaction[]
  dmSent       DirectMessage[] @relation("DmFrom")
  dmReceived   DirectMessage[] @relation("DmTo")
  ledOrg       Organization?   @relation("OrgLeader")
  orgMember    OrgMember?
  orgInvites   OrgInvite[]
  explorationLogs ExplorationLog[]
  equipment    EquippedItem[]
  tradesAuthored TradeListing[] @relation("TradeAuthor")
  tradesTaken    TradeListing[] @relation("TradeCounterparty")
  auctionsWon    Auction[]      @relation("AuctionWinner")
  bids           Bid[]
}

enum AbilityEffectType {
  CHECK_BONUS   // 판정 보정
  EXTRA_DICE    // 다이스 추가
  AUTO_SUCCESS  // 자동 성공 (하루 n회)
  TELEPORT      // 공간 이동 (하루 n회)
  CRAFT_DOUBLE  // 제작 2배 (2차)
  NARRATIVE     // 서술 전용
}

model AbilityEffect {
  id          String            @id @default(cuid())
  characterId String
  character   Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        AbilityEffectType
  checkType   CheckType?
  value       Int               @default(0)
  perDay      Int               @default(0)
  note        String            @default("")
  sortOrder   Int               @default(0)
}

model AbilityTag {
  id         String         @id @default(cuid())
  name       String         @unique
  createdAt  DateTime       @default(now())
  characters CharacterTag[]
}

model CharacterTag {
  characterId String
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tagId       String
  tag         AbilityTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([characterId, tagId])
}

// ───────────────────────── 이계 ─────────────────────────

enum RealmKind {
  FIXED    // 고정 이계
  INSTANT  // 인스턴트 이계 (2차)
  SPECIAL  // 특수형 이계 (2차)
}

model Realm {
  id          String    @id @default(cuid())
  name        String
  intro       String    @default("")
  kind        RealmKind @default(FIXED)
  // 세계 지도 위 위치 (0~100, 지도 너비·높이 기준 백분율)
  mapX        Float     @default(50)
  mapY        Float     @default(50)
  startNodeId String?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 인스턴트 이계 (2차). 템플릿은 지도에 나오지 않고, 인스턴스가 복제되어 나온다.
  isTemplate         Boolean   @default(false)
  templateId         String?
  template           Realm?    @relation("Instances", fields: [templateId], references: [id], onDelete: SetNull)
  instances          Realm[]   @relation("Instances")
  spawnIntervalHours Int       @default(24)
  maxConcurrent      Int       @default(2)
  lastSpawnAt        DateTime?
  sealedAt           DateTime?
  sealedById         String?

  nodes Node[]
  edges Edge[]
  runs  Run[]
  explorationLogs ExplorationLog[]
}

model Node {
  id           String  @id @default(cuid())
  realmId      String
  realm        Realm   @relation(fields: [realmId], references: [id], onDelete: Cascade)
  name         String
  description  String  @default("")
  depth        Int     @default(1)
  isExit       Boolean @default(false)
  // null이면 기본값(= 층 수) 사용
  entryErosion Int?
  // null이면 게임 설정의 기본 보수 사용
  rewardNew    Int?
  rewardKnown  Int?
  // 편집기 좌표
  posX         Float   @default(0)
  posY         Float   @default(0)

  // 서버 전체 공개
  revealedAt   DateTime?
  revealedById String?
  revealedBy   Character? @relation("RevealedBy", fields: [revealedById], references: [id], onDelete: SetNull)

  scenes   Scene[]
  edgesOut Edge[]  @relation("EdgeFrom")
  edgesIn  Edge[]  @relation("EdgeTo")
  runLogs  RunLog[]
  memos    ExplorationLog[]
}

model Edge {
  id            String  @id @default(cuid())
  realmId       String
  realm         Realm   @relation(fields: [realmId], references: [id], onDelete: Cascade)
  fromId        String
  from          Node    @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId          String
  to            Node    @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  bidirectional Boolean @default(true)
  // 통과 조건 (조건 목록, 선택지와 같은 형식). 비어 있으면 자유 통과.
  conditions    Json    @default("[]")
  // 통과 판정. null이면 판정 없음.
  checkType     CheckType?
  checkTarget   Int?
  failText      String  @default("")
  failEffects   Json    @default("[]")
}

enum SceneKind {
  BASE   // 기본 장면
  EVENT  // 진입 시 확률로 발생하는 이벤트 장면
}

model Scene {
  id        String    @id @default(cuid())
  nodeId    String
  node      Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  kind      SceneKind @default(BASE)
  name      String    @default("")
  text      String    @default("")
  chance    Int       @default(100) // 0~100 (%)
  mandatory Boolean   @default(false)
  sortOrder Int       @default(0)
  choices   Choice[]
}

enum LockedDisplay {
  HIDE         // 숨김
  SHOW_LOCKED  // 잠긴 채 표시
}

model Choice {
  id            String        @id @default(cuid())
  sceneId       String
  scene         Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  text          String
  conditions    Json          @default("[]")
  lockedDisplay LockedDisplay @default(HIDE)
  checkType     CheckType?
  checkTarget   Int?
  oncePerRun    Boolean       @default(false)
  sortOrder     Int           @default(0)

  successOutcomeId String?  @unique
  successOutcome   Outcome? @relation("Success", fields: [successOutcomeId], references: [id], onDelete: SetNull)
  failOutcomeId    String?  @unique
  failOutcome      Outcome? @relation("Fail", fields: [failOutcomeId], references: [id], onDelete: SetNull)
}

model Outcome {
  id      String @id @default(cuid())
  text    String @default("")
  effects Json   @default("[]")

  successOf Choice? @relation("Success")
  failOf    Choice? @relation("Fail")
}

// ───────────────────────── 아이템 ─────────────────────────

enum ItemCategory {
  CONSUMABLE  // 소모품
  INFECTED    // 감염물
  MATERIAL    // 재료
  KEY         // 중요 물품
  EQUIPMENT   // 장비 (2차)
  FACTOR      // 현실조작인자 (2차, 추출로 생성)
}

enum UsableIn {
  RUN      // 런 중
  OUTSIDE  // 런 밖
  BOTH
}

model Item {
  id          String       @id @default(cuid())
  name        String
  description String       @default("")
  imageUrl    String?
  category    ItemCategory @default(CONSUMABLE)
  effects     Json         @default("[]")
  usableIn    UsableIn     @default(BOTH)
  stackLimit  Int          @default(99)
  shopEnabled Boolean      @default(false)
  price       Int          @default(0)
  minLevel    Int          @default(0)
  minEscapes  Int          @default(0)
  sellPrice   Int          @default(0) // 회수가. 0이면 판매 불가
  sortOrder   Int          @default(0)
  // 생산 (2차): 감염물의 이계 특성 태그 / 인자의 특성 태그
  traitTag    String       @default("")
  // 조합으로 만들어진 장비 (상점·편집 목록에서 숨김)
  isCrafted   Boolean      @default(false)
  crafterId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  dropEntries DropEntry[]
  inventory   InventoryItem[]
  equipped    EquippedItem[]
  recipesBase   Recipe[] @relation("RecipeBase")
  recipesResult Recipe[] @relation("RecipeResult")
  tradeOffers   TradeListing[] @relation("TradeOffer")
  tradeAsks     TradeListing[] @relation("TradeAsk")
  auctions      Auction[]
}

// ───────────────────────── 생산 (2차) ─────────────────────────

model EquippedItem {
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  slot        Int
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([characterId, slot])
}

/** 이계 특성 태그: 인자에 붙으며, 조합된 장비에 보너스 효과를 더한다 */
model FactorTrait {
  id           String @id @default(cuid())
  tag          String @unique
  description  String @default("")
  bonusEffects Json   @default("[]")
}

model Recipe {
  id           String @id @default(cuid())
  name         String
  baseItemId   String
  baseItem     Item   @relation("RecipeBase", fields: [baseItemId], references: [id], onDelete: Cascade)
  resultItemId String
  resultItem   Item   @relation("RecipeResult", fields: [resultItemId], references: [id], onDelete: Cascade)
  checkTarget  Int    @default(7)
  sortOrder    Int    @default(0)
}

model DropTable {
  id        String      @id @default(cuid())
  name      String
  createdAt DateTime    @default(now())
  entries   DropEntry[]
}

model DropEntry {
  id      String    @id @default(cuid())
  tableId String
  table   DropTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  // null이면 "아무것도 없음"
  itemId  String?
  item    Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  weight  Int       @default(1)
  minQty  Int       @default(1)
  maxQty  Int       @default(1)
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty         Int       @default(1)

  @@unique([characterId, itemId])
}

// ───────────────────────── 런 ─────────────────────────

enum RunStatus {
  ACTIVE
  ESCAPED
  FALLEN
  ABORTED  // 관리자 강제 종료
}

model Run {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  realmId     String
  realm       Realm     @relation(fields: [realmId], references: [id], onDelete: Cascade)
  status      RunStatus @default(ACTIVE)
  isTest      Boolean   @default(false)

  currentNodeId  String?
  currentSceneId String?
  previousNodeId String?
  // 이번 런에서 밝힌 노드 id 목록 (서버에 아직 미공개였던 것)
  revealedNodeIds Json @default("[]")
  // 이번 런에서 들어간 노드 id 목록 (순서대로)
  visitedNodeIds  Json @default("[]")
  flags           Json @default("[]")
  usedChoiceIds   Json @default("[]")
  // 이번 런 획득 아이템 [{itemId, qty}]
  loot            Json @default("[]")
  // 이번 런 보정 [{type, checkType, value}]
  modifiers       Json @default("[]")
  // 쓰러짐 시 잃은 아이템 [{itemId, qty}]
  lostLoot        Json @default("[]")
  // 획득한 정보 단서 [{text, flag}]
  clues           Json @default("[]")
  exp             Int  @default(0)
  reward          Int  @default(0)
  // 테스트 플레이: 판정 강제 (null | "SUCCESS" | "FAIL")
  forceResult     String?
  // 테스트 플레이에서는 실제 캐릭터 대신 이 스냅샷의 수치를 쓴다
  testState       Json?
  // 직전 행동의 결과 (판정 결과 화면용). "계속"을 누르면 비운다
  lastResult      Json?
  // 런 종료 요약 (런 종료 화면용)
  summary         Json?
  // 입장 시 이계용 비디오 카메라를 지니고 있었는지 (카메라 로그 작성 조건)
  hadCamera       Boolean @default(false)
  logs2           ExplorationLog[]

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  logs RunLog[]

  @@index([characterId, status])
}

// ───────────────────────── 탐사 로그 (2차) ─────────────────────────

enum LogKind {
  DIARY   // 일기 로그: 짧은 글, 즉시 보수
  CAMERA  // 카메라 로그: 정리된 글·그림, 운영자 심사 후 지급
}

enum LogStatus {
  PENDING   // 심사 중 (카메라)
  APPROVED  // 공개됨
  REJECTED  // 반려
}

model ExplorationLog {
  id           String    @id @default(cuid())
  kind         LogKind
  status       LogStatus @default(APPROVED)
  runId        String
  run          Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  realmId      String
  realm        Realm     @relation(fields: [realmId], references: [id], onDelete: Cascade)
  // 맵 메모로 남길 노드 (일기 로그)
  nodeId       String?
  node         Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  title        String
  body         String
  imageUrl     String?
  // 댓글·공감용 글
  postId       String    @unique
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  rewardPaid   Int       @default(0)
  adminComment String    @default("")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  archiveEntry ArchiveEntry?

  @@unique([runId, kind])
  @@index([realmId, nodeId])
  @@index([status, createdAt])
}

model RunLog {
  id          String   @id @default(cuid())
  runId       String
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq         Int
  type        String   // enter, choice, check, outcome, item, system, end ...
  nodeId      String?
  node        Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  choiceText  String?
  text        String   @default("")
  checkDetail Json?
  deltas      Json?
  createdAt   DateTime @default(now())

  @@index([runId, seq])
}

// ───────────────────────── 운영 ─────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────── 커뮤니티 (2차) ─────────────────────────

enum PostKind {
  TIMELINE  // SNS 타임라인 (짧은 글)
  BOARD     // 게시판
  ORG       // 조직 게시판
  LOG       // 탐사 로그에 딸린 댓글·공감용
  TRADE     // 거래 게시글에 딸린 댓글(흥정)용
}

model Post {
  id          String    @id @default(cuid())
  kind        PostKind
  authorId    String
  author      Character @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String    @default("")
  body        String
  isAnonymous Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
  reactions   Reaction[]
  log         ExplorationLog?
  trade       TradeListing?

  @@index([kind, createdAt])
  @@index([orgId, createdAt])
}

model Comment {
  id             String    @id @default(cuid())
  postId         String
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId       String
  author         Character @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  isAnonymous    Boolean   @default(false)
  // RP 댓글로 인정되어 침식률이 감소했는지
  erosionApplied Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([postId, createdAt])
}

model Reaction {
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([postId, characterId])
}

model DirectMessage {
  id        String    @id @default(cuid())
  fromId    String
  from      Character @relation("DmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Character @relation("DmTo", fields: [toId], references: [id], onDelete: Cascade)
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([fromId, toId, createdAt])
  @@index([toId, readAt])
}

model Organization {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @default("")
  // 홍보 여부. false면 목록에 나오지 않는 비밀 조직
  isPublic    Boolean     @default(true)
  leaderId    String      @unique
  leader      Character   @relation("OrgLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  members     OrgMember[]
  invites     OrgInvite[]
  posts       Post[]
}

model OrgMember {
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  characterId String       @unique // 한 사람은 한 조직에만
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // 이름 옆에 조직 이름을 표시할지 (본인이 선택)
  showBadge   Boolean      @default(true)
  joinedAt    DateTime     @default(now())

  @@id([orgId, characterId])
}

enum OrgInviteKind {
  INVITE  // 수장이 보낸 영입 신청
  APPLY   // 유저가 보낸 가입 신청
}

enum OrgInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model OrgInvite {
  id          String          @id @default(cuid())
  orgId       String
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  characterId String
  character   Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  kind        OrgInviteKind
  status      OrgInviteStatus @default(PENDING)
  message     String          @default("")
  createdAt   DateTime        @default(now())
  decidedAt   DateTime?

  @@index([characterId, status])
  @@index([orgId, status])
}

// ───────────────────────── 도감 (2차) ─────────────────────────

enum ArchiveCategory {
  REALM     // 이계
  CREATURE  // 이계 생물
  INFECTED  // 감염물
}

model ArchiveEntry {
  id           String          @id @default(cuid())
  category     ArchiveCategory
  code         String          @default("") // 문서 번호 (예: ARC-017)
  title        String
  summary      String          @default("")
  imageUrl     String?
  isPublished  Boolean         @default(false)
  sortOrder    Int             @default(0)
  // 채택한 로그 (작성자 이름 표시)
  adoptedLogId String?         @unique
  adoptedLog   ExplorationLog? @relation(fields: [adoptedLogId], references: [id], onDelete: SetNull)
  stages       ArchiveStage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ArchiveStage {
  id         String       @id @default(cuid())
  entryId    String
  entry      ArchiveEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0)
  title      String       @default("")
  body       String       @default("")
  // 해금 조건 목록. 비어 있으면 누구나. [{type:"flag",flag},{type:"realm_escapes",realmId,count},{type:"item",itemId}]
  conditions Json         @default("[]")
  // 잠겨 있을 때 보여 줄 힌트
  hint       String       @default("")
}


// ───────────────────────── 거래 (2차) ─────────────────────────

enum TradeKind {
  SELL     // 유저 간 매매: 아이템을 P에 판다
  BARTER   // 물물교환: 아이템과 아이템
  REQUEST  // 주문 제작 의뢰: P를 걸고 물건을 받는다
}

enum TradeStatus {
  OPEN
  DONE
  CANCELLED
}

model TradeListing {
  id             String      @id @default(cuid())
  kind           TradeKind
  status         TradeStatus @default(OPEN)
  authorId       String
  author         Character   @relation("TradeAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  body           String      @default("")
  // 내놓는 것 (SELL·BARTER: 보관 중인 아이템)
  offerItemId    String?
  offerItem      Item?       @relation("TradeOffer", fields: [offerItemId], references: [id], onDelete: Cascade)
  offerQty       Int         @default(1)
  // 원하는 것
  askPoints      Int         @default(0) // SELL: 가격, REQUEST: 보수(보관됨)
  askItemId      String?
  askItem        Item?       @relation("TradeAsk", fields: [askItemId], references: [id], onDelete: Cascade)
  askQty         Int         @default(1)
  // 성사 상대와 납품 물건
  counterpartyId String?
  counterparty   Character?  @relation("TradeCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)
  deliveredItemId String?
  postId         String      @unique
  post           Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  closedAt       DateTime?

  @@index([status, createdAt])
}

enum AuctionStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Auction {
  id           String        @id @default(cuid())
  title        String
  body         String        @default("")
  itemId       String
  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty          Int           @default(1)
  startPrice   Int           @default(100)
  minIncrement Int           @default(10)
  endsAt       DateTime
  status       AuctionStatus @default(OPEN)
  winnerId     String?
  winner       Character?    @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  finalPrice   Int?
  createdById  String?
  createdAt    DateTime      @default(now())
  bids         Bid[]

  @@index([status, endsAt])
}

model Bid {
  id          String    @id @default(cuid())
  auctionId   String
  auction     Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  amount      Int
  createdAt   DateTime  @default(now())

  @@index([auctionId, amount])
}
