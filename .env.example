# 로컬 개발용 Postgres. 나중에 Supabase Postgres 접속 문자열로 바꾸면 그대로 동작한다.
DATABASE_URL="postgresql://postgres@localhost:5432/contact?host=/tmp"
# 마이그레이션용 직접 접속. Supabase에서는 Session pooler(5432) 주소, 로컬은 DATABASE_URL과 동일
DIRECT_URL="postgresql://postgres@localhost:5432/contact?host=/tmp"
# 세션 쿠키 서명용 비밀값. 배포 시 반드시 바꿀 것.
SESSION_SECRET="dev-only-change-me-0123456789abcdef"
# 시드가 만드는 첫 관리자 계정
ADMIN_LOGIN_ID="admin"
ADMIN_PASSWORD="admin1234"

# 배포(Vercel)에서 이미지 저장: Supabase Storage. 비워 두면 서버 로컬 폴더에 저장
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="uploads"
